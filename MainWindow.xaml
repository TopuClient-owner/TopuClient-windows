
<Window x:Class="TopuLauncher.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     mc:Ignorable="d"
     Title="Topu Client"
     Icon="Assets/TopuLauncher.ico"
     Height="650"
     Width="1000"
     MinHeight="650"
     MinWidth="900"
     WindowStartupLocation="CenterScreen"
     WindowStyle="None"
     AllowsTransparency="True"
     Background="Transparent">

<Window.Resources>

    <!-- ========================================================= -->
    <!-- COLORS -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="WindowBackground"
                     Color="#101114"/>

    <SolidColorBrush x:Key="SidebarBackground"
                     Color="#15171B"/>

    <SolidColorBrush x:Key="CardBackground"
                     Color="#191B20"/>

    <SolidColorBrush x:Key="CardBorder"
                     Color="#292C33"/>

    <SolidColorBrush x:Key="InputBackground"
                     Color="#111318"/>

    <SolidColorBrush x:Key="InputBorder"
                     Color="#30343C"/>

    <SolidColorBrush x:Key="MutedText"
                     Color="#777D88"/>

    <SolidColorBrush x:Key="SecondaryText"
                     Color="#A8ADB7"/>

    <SolidColorBrush x:Key="PrimaryText"
                     Color="#F5F7FA"/>

    <SolidColorBrush x:Key="TopuGreen"
                     Color="#00FF88"/>

    <SolidColorBrush x:Key="TopuGreenDark"
                     Color="#00C96A"/>

    <!-- ========================================================= -->
    <!-- CARD -->
    <!-- ========================================================= -->

    <Style x:Key="CardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="12"/>
        <Setter Property="Padding"
                Value="16"/>
    </Style>

    <!-- ========================================================= -->
    <!-- MODERN BUTTON -->
    <!-- ========================================================= -->

    <Style x:Key="ModernButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="#22252B"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderBrush"
                Value="#343840"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="12,7"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#2B2F36"/>
                <Setter Property="BorderBrush"
                        Value="#454A54"/>
            </Trigger>

            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="#17191D"/>
            </Trigger>

            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity"
                        Value="0.45"/>
            </Trigger>

        </Style.Triggers>

    </Style>

    <!-- ========================================================= -->
    <!-- GREEN BUTTON -->
    <!-- ========================================================= -->

    <Style x:Key="GreenButton"
           TargetType="Button"
           BasedOn="{StaticResource ModernButton}">

        <Setter Property="Background"
                Value="{StaticResource TopuGreen}"/>

        <Setter Property="Foreground"
                Value="#07100B"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource TopuGreen}"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#33FF9F"/>
                <Setter Property="BorderBrush"
                        Value="#33FF9F"/>
            </Trigger>

        </Style.Triggers>

    </Style>

    <!-- ========================================================= -->
    <!-- INPUT -->
    <!-- ========================================================= -->

    <Style x:Key="ModernTextBox"
           TargetType="TextBox">

        <Setter Property="Background"
                Value="{StaticResource InputBackground}"/>

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource InputBorder}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Padding"
                Value="10,6"/>

        <Setter Property="Height"
                Value="36"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

    </Style>

    <!-- ========================================================= -->
    <!-- COMBOBOX -->
    <!-- ========================================================= -->

    <Style x:Key="ModernComboBox"
           TargetType="ComboBox">

        <Setter Property="Background"
                Value="{StaticResource InputBackground}"/>

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource InputBorder}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Height"
                Value="36"/>

    </Style>

    <!-- ========================================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================================= -->

    <Style x:Key="SidebarButton"
           TargetType="Button">

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="Foreground"
                Value="#858A94"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Padding"
                Value="18,0"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="#1D2025"/>

                <Setter Property="Foreground"
                        Value="#DCE1E8"/>

            </Trigger>

        </Style.Triggers>

    </Style>

</Window.Resources>

<Border Background="{StaticResource WindowBackground}"
        CornerRadius="14"
        BorderBrush="#30343B"
        BorderThickness="1">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TITLE BAR -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#15171B"
                CornerRadius="14,14,0,0"
                MouseDown="TitleBar_MouseDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">

                    <Border Width="26"
                            Height="26"
                            CornerRadius="7"
                            Background="#0B2C1C"
                            BorderBrush="#164D32"
                            BorderThickness="1"
                            Margin="0,0,9,0">

                        <TextBlock Text="⚡"
                                   Foreground="{StaticResource TopuGreen}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>

                    </Border>

                    <TextBlock Text="TOPU CLIENT"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  PvP Edition"
                               Foreground="#626872"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="—"
                            Width="45"
                            Height="46"
                            Background="Transparent"
                            Foreground="#858A94"
                            BorderThickness="0"
                            FontSize="16"
                            Click="Minimize_Click"/>

                    <Button Content="✕"
                            Width="45"
                            Height="46"
                            Background="Transparent"
                            Foreground="#858A94"
                            BorderThickness="0"
                            FontSize="14"
                            Click="Close_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- SIDEBAR -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="#24272D"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock Text="NAVIGATION"
                                   Foreground="#50555E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="18,22,18,8"/>

                        <Button x:Name="TabLaunchBtn"
                                Content="  ⚡   Launch Game"
                                Height="46"
                                Style="{StaticResource SidebarButton}"
                                Foreground="{StaticResource TopuGreen}"
                                BorderBrush="{StaticResource TopuGreen}"
                                BorderThickness="3,0,0,0"
                                Tag="TabLaunch"
                                Click="SwitchTab_Click"/>

                        <Button x:Name="TabProfilesBtn"
                                Content="  ◈   Profiles &amp; Mods"
                                Height="46"
                                Style="{StaticResource SidebarButton}"
                                Tag="TabProfiles"
                                Click="SwitchTab_Click"/>

                        <Button x:Name="TabAccountsBtn"
                                Content="  ●   Accounts"
                                Height="46"
                                Style="{StaticResource SidebarButton}"
                                Tag="TabAccounts"
                                Click="SwitchTab_Click"/>

                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="18,0,18,18">

                        <Border Background="#101216"
                                BorderBrush="#252931"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="TOPU CLIENT"
                                           Foreground="#5E646E"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <TextBlock Text="High Performance"
                                           Foreground="#DCE1E8"
                                           FontSize="11"
                                           Margin="0,2,0,0"/>

                                <TextBlock Text="Fabric PvP Launcher"
                                           Foreground="{StaticResource TopuGreen}"
                                           FontSize="10"
                                           Margin="0,1,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="26">

                    <!-- ========================================= -->
                    <!-- LAUNCH TAB -->
                    <!-- ========================================= -->

                    <StackPanel x:Name="TabLaunch"
                                Visibility="Visible">

                        <TextBlock Text="Launch Game"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Ready for competitive Minecraft."
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,5,0,22"/>

                        <!-- ACCOUNT CARD -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="ACCOUNT"
                                               Foreground="#666C76"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="LaunchAccountLabel"
                                               Text="No account"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>

                                    <TextBlock x:Name="LaunchAccountTypeLabel"
                                               Text="Add an account in Accounts"
                                               Foreground="{StaticResource TopuGreen}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="●"
                                           Foreground="{StaticResource TopuGreen}"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- PROFILE CARD -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="ACTIVE PROFILE"
                                               Foreground="#666C76"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="LaunchProfileLabel"
                                               Text="default"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">

                                        <TextBlock Text="Fabric"
                                                   Foreground="{StaticResource TopuGreen}"
                                                   FontSize="11"/>

                                        <TextBlock Text="  •  "
                                                   Foreground="#555A63"
                                                   FontSize="11"/>

                                        <TextBlock x:Name="LaunchVersionLabel"
                                                   Text="1.21.1"
                                                   Foreground="#A8ADB7"
                                                   FontSize="11"/>

                                        <TextBlock Text="  •  "
                                                   Foreground="#555A63"
                                                   FontSize="11"/>

                                        <TextBlock x:Name="LaunchRamLabel"
                                                   Text="4GB RAM"
                                                   Foreground="#A8ADB7"
                                                   FontSize="11"/>

                                    </StackPanel>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="◈"
                                           Foreground="{StaticResource TopuGreen}"
                                           FontSize="22"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <TextBlock Text="QUICK SERVER CONNECT"
                                   Foreground="#666C76"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,22">

                            <Button Content="GamerTee"
                                    Width="115"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource ModernButton}"
                                    Tag="gametee.net"
                                    Click="JoinServer_Click"/>

                            <Button Content="Sharpness.gg"
                                    Width="125"
                                    Height="36"
                                    Style="{StaticResource ModernButton}"
                                    Tag="sharpness.gg"
                                    Click="JoinServer_Click"/>

                        </StackPanel>

                        <Button x:Name="LaunchBtn"
                                Content="⚡   LAUNCH FABRIC"
                                Height="52"
                                Style="{StaticResource GreenButton}"
                                FontSize="14"
                                Click="LaunchBtn_Click"/>

                        <TextBlock Text="Your selected account and profile will be used automatically."
                                   Foreground="#555A63"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- PROFILE TAB -->
                    <!-- ========================================= -->

                    <StackPanel x:Name="TabProfiles"
                                Visibility="Collapsed">

                        <TextBlock Text="Profiles &amp; Mods"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Every profile has its own Minecraft installation, mods, worlds and settings."
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,5,0,20"/>

                        <!-- PROFILE SELECTOR -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <StackPanel>

                                <TextBlock Text="ACTIVE PROFILE"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,7"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="ProfileSelector"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="ProfileSelector_SelectionChanged"/>

                                    <Button Grid.Column="1"
                                            Content="+ New"
                                            Height="36"
                                            Width="75"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ModernButton}"
                                            Click="CreateProfile_Click"/>

                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Height="36"
                                            Width="75"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ModernButton}"
                                            Click="DeleteProfile_Click"/>

                                </Grid>

                                <Grid Margin="0,9,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="NewProfileInput"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             ToolTip="New profile name"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Example: pvp, survival, testing"
                                               Foreground="#555A63"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- SETTINGS -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <StackPanel>

                                <TextBlock Text="PROFILE SETTINGS"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Minecraft Version"
                                                   Foreground="#C8CDD5"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>

                                        <ComboBox x:Name="VersionBox"
                                                  Width="170"
                                                  Height="34"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ModernComboBox}">

                                            <ComboBoxItem Content="1.21.1"/>
                                            <ComboBoxItem Content="1.21.4"/>
                                            <ComboBoxItem Content="1.21.8"/>
                                            <ComboBoxItem Content="1.21.11"/>
                                            <ComboBoxItem Content="26.1.2"/>
                                            <ComboBoxItem Content="26.2"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Allocated RAM"
                                                   Foreground="#C8CDD5"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>

                                        <StackPanel Orientation="Horizontal">

                                            <Slider x:Name="RamSlider"
                                                    Width="230"
                                                    Minimum="2"
                                                    Maximum="12"
                                                    Value="4"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="RamSlider_ValueChanged"
                                                    VerticalAlignment="Center"/>

                                            <TextBlock x:Name="RamLabel"
                                                       Text="4GB"
                                                       Foreground="{StaticResource TopuGreen}"
                                                       FontWeight="Bold"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Grid>

                                <Button Content="Save Profile Settings"
                                        Width="170"
                                        Height="36"
                                        Margin="0,18,0,0"
                                        Style="{StaticResource GreenButton}"
                                        HorizontalAlignment="Left"
                                        Click="SaveProfile_Click"/>

                                <TextBlock x:Name="SelectedProfileLabel"
                                           Text="● default • Fabric 1.21.1 • 4GB RAM"
                                           Foreground="{StaticResource TopuGreen}"
                                           FontSize="11"
                                           Margin="0,12,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- MOD MANAGER -->

                        <Border Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="MODRINTH MOD MANAGER"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="ModSearchInput"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="36"/>

                                    <Button Grid.Column="1"
                                            Content="Search &amp; Add"
                                            Width="125"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource GreenButton}"
                                            Click="SearchModrinth_Click"/>

                                </Grid>

                                <TextBlock x:Name="ModSearchStatus"
                                           Text="Optimization stack installs automatically."
                                           Foreground="{StaticResource MutedText}"
                                           FontSize="10"
                                           Margin="0,9,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- ACCOUNTS TAB -->
                    <!-- ========================================= -->

                    <StackPanel x:Name="TabAccounts"
                                Visibility="Collapsed">

                        <TextBlock Text="Accounts"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Save offline and Microsoft accounts and switch between them whenever you want."
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,5,0,20"/>

                        <!-- CURRENT ACCOUNT -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="SELECTED ACCOUNT"
                                               Foreground="#666C76"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="SelectedAccountLabel"
                                               Text="No account selected"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>

                                    <TextBlock x:Name="SelectedAccountTypeLabel"
                                               Text="Add an account below"
                                               Foreground="{StaticResource TopuGreen}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="●"
                                           Foreground="{StaticResource TopuGreen}"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- ACCOUNT SELECTOR -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <StackPanel>

                                <TextBlock Text="SAVED ACCOUNTS"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="AccountSelector"
                                          Height="38"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="AccountSelector_SelectionChanged"/>

                                <Button Content="Remove Selected Account"
                                        Width="190"
                                        Height="34"
                                        Margin="0,9,0,0"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Left"
                                        Click="RemoveAccount_Click"/>

                            </StackPanel>

                        </Border>

                        <!-- OFFLINE -->

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <StackPanel>

                                <TextBlock Text="OFFLINE"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Add a username once. Topu Client remembers it for future launches."
                                           Foreground="{StaticResource MutedText}"
                                           FontSize="11"
                                           Margin="0,4,0,10"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="OfflineUsernameInput"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="36"
                                             ToolTip="Minecraft username"/>

                                    <Button Grid.Column="1"
                                            Content="Add Offline Account"
                                            Width="160"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource GreenButton}"
                                            Click="AddOfflineAccount_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- MICROSOFT -->

                        <Border Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="MICROSOFT ACCOUNT"
                                           Foreground="#666C76"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Use Microsoft account . Your saved Microsoft account can be selected again without logging in every launch."
                                           Foreground="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12"/>

                                <Button x:Name="MsLoginBtn"
                                        Content="Sign in with Microsoft"
                                        Width="190"
                                        Height="38"
                                        Background="#1683D8"
                                        Foreground="White"
                                        BorderBrush="#1683D8"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ModernButton}"
                                        Click="MsLoginBtn_Click"/>

                            </StackPanel>

                        </Border>

